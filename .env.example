# JWT 密钥 - 生产环境必须修改！
JWT_SECRET=your-production-secret-key-here

# 允许访问 API/Socket 的前端地址，多个用英文逗号分隔。
# 示例：http://your-server-ip 或 https://your-domain.com
CORS_ORIGINS=http://your-server-ip

# 管理员用户名，多个用英文逗号分隔；不需要管理模板功能可留空。
ADMIN_USERNAMES=

# AI 小助手暂不启用，相关配置先保留为注释，后续打磨完成后再打开。
# AI_PROVIDER 支持 openai 或 minimax。
# OpenAI 默认模型：gpt-4.1-mini；MiniMax 默认模型：MiniMax-M2.7。
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=
# AI_BASE_URL=
# AI_TIMEOUT_MS=15000
